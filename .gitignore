# Fed Agent: publish source by allowlist; keep local work outside Git.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/AGENT_OPERATIONS_AND_REGISTRY.md
!/agent.cmd
!/agent_mvp/
!/.github/

/agent_mvp/*
!/agent_mvp/.gitignore
!/agent_mvp/.env.example
!/agent_mvp/README.md
!/agent_mvp/pyproject.toml
!/agent_mvp/requirements-windows-py310.txt
!/agent_mvp/start_agent.py
!/agent_mvp/src/
!/agent_mvp/tests/
!/agent_mvp/docs/
!/agent_mvp/examples/
!/agent_mvp/scripts/
!/agent_mvp/evaluation/

/agent_mvp/src/*
!/agent_mvp/src/federated_agent/
/agent_mvp/src/federated_agent/data/catalogs/*
!/agent_mvp/src/federated_agent/data/catalogs/algorithms.json
!/agent_mvp/src/federated_agent/data/catalogs/algorithm_store.json
!/agent_mvp/src/federated_agent/data/catalogs/AYA_cancer_schema.jsonld
!/agent_mvp/src/federated_agent/data/catalogs/execution_templates.json
/agent_mvp/src/federated_agent/data/config/*
!/agent_mvp/src/federated_agent/data/config/demo_deployment.json
!/agent_mvp/src/federated_agent/data/config/ubuntu_sandbox.json
!/agent_mvp/src/federated_agent/data/config/ubuntu_data_availability.json
!/agent_mvp/src/federated_agent/data/config/data_availability.example.json
!/agent_mvp/src/federated_agent/data/config/policy.json
!/agent_mvp/src/federated_agent/data/config/policy.opa.example.json
!/agent_mvp/src/federated_agent/data/config/registry_publish.json
!/agent_mvp/src/federated_agent/data/config/registry_source.local.example.json
!/agent_mvp/src/federated_agent/data/config/registry_source.production.example.json
/agent_mvp/docs/*
!/agent_mvp/docs/*.md
/agent_mvp/docs/BACKGROUND_MEDICAL_AGENTS_SDK.md
/agent_mvp/scripts/*
!/agent_mvp/scripts/evaluate_requests.py
!/agent_mvp/scripts/generate_feedback_examples.py
!/agent_mvp/scripts/sync_catalogs.py
!/agent_mvp/scripts/check_release.py

# Apply even inside allowed source directories.
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
deepseek-api.txt
Vantage6.txt
private/
secrets/
output/
output-*/
*.zip
*.log
*.tmp
